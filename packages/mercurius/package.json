{
  "name": "@nestjs/mercurius",
  "version": "14.2.0",
  "description": "Mercurius driver for @nestjs/graphql: GraphQL APIs on Fastify, with subscriptions and federation.",
  "keywords": [
    "nestjs",
    "nest",
    "graphql",
    "mercurius",
    "fastify",
    "federation"
  ],
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestjs/graphql.git"
  },
  "scripts": {
    "test:e2e": "vitest run",
    "test:e2e:dev": "vitest watch"
  },
  "bugs": {
    "url": "https://github.com/nestjs/graphql/issues"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@mercuriusjs/federation": "5.1.1",
    "@mercuriusjs/gateway": "5.2.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@nestjs/testing": "12.3.3",
    "fastify": "5.12.8",
    "mercurius": "16.12.1",
    "mercurius-integration-testing": "9.0.1"
  },
  "peerDependencies": {
    "@apollo/subgraph": "^2.0.0",
    "@mercuriusjs/federation": "^5.0.0",
    "@mercuriusjs/gateway": "^5.1.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "fastify": "^5.2.1",
    "graphql": "^16.10.0 || ^17.0.0",
    "mercurius": "^16.11.0"
  },
  "peerDependenciesMeta": {
    "@apollo/subgraph": {
      "optional": true
    },
    "@mercuriusjs/gateway": {
      "optional": true
    },
    "@mercuriusjs/federation": {
      "optional": true
    }
  }
}
